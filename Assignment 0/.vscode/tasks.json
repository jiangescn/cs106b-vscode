{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "配置（Debug / Ninja）",
      "type": "shell",
      "command": "${workspaceFolder}/../toolchain/CMake_64/bin/cmake.exe",
      "args": [
        "--preset",
        "debug-ninja"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "构建（Debug / Ninja）",
      "type": "shell",
      "command": "${workspaceFolder}/../toolchain/CMake_64/bin/cmake.exe",
      "args": [
        "--build",
        "--preset",
        "debug-ninja"
      ],
      "dependsOn": "配置（Debug / Ninja）",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    }
  ]
}
