{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前作业（Debug / Ninja）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${workspaceFolder}/../toolchain/Qt/6.11.1/mingw_64/bin;${workspaceFolder}/../toolchain/mingw1310_64/bin;${env:PATH}"
        }
      ],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/../toolchain/mingw1310_64/bin/gdb.exe",
      "preLaunchTask": "构建（Debug / Ninja）",
      "avoidWindowsConsoleRedirection": true
    }
  ]
}
