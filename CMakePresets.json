{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cs106-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../cmake/CS106Toolchain.cmake"
      },
      "environment": {
        "PATH": "C:/Qt/Tools/Ninja;$env{CS106B_NINJA};$penv{PATH}"
      }
    }
  ]
}
