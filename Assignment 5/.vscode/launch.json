{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前作业（Debug / Ninja）",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
